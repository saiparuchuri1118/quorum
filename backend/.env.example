# Copy to .env and fill in ONE provider's key. Never commit the real file,
# and never paste a key into a chat window or a ticket — if you do, revoke it
# and issue a new one rather than reusing it.
#
# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Free tier, no credit card — https://aistudio.google.com/apikey
#GOOGLE_API_KEY=

# https://platform.openai.com/api-keys
#OPENAI_API_KEY=

# Cheaper alternative — https://platform.deepseek.com/api_keys
#DEEPSEEK_API_KEY=

# Ollama needs no key. Install from https://ollama.com/download, then
# `ollama pull qwen3` and run with --provider ollama.
#OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional, free — macro indicators for the News Analyst.
# https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=
